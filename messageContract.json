{
  "UserLoggedInEvent": {
    "type": "UserLoggedInEvent",
    "required_fields": ["timestamp", "payload.user_id"],
    "payload_schema": {
      "user_id": "string"
    }
  },
  "DataProcessedEvent": {
    "type": "DataProcessedEvent",
    "required_fields": ["timestamp", "payload.data_id", "payload.processing_time"],
